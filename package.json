{
  "name": "korean-class-subtitler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run server:dev\" \"npm run vite:dev\"",
    "vite:dev": "vite --host 0.0.0.0 --configLoader runner",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "node dist-server/server/index.js",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "npm run server:start",
    "smoke:openai": "tsx scripts/openai-smoke-test.ts",
    "test": "vitest run --config vitest.config.mts --configLoader runner",
    "test:watch": "vitest --config vitest.config.mts --configLoader runner"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "jsdom": "^27.3.0",
    "lucide-react": "^0.561.0",
    "node-mocks-http": "^1.17.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
