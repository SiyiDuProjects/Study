{
  "name": "study-lecture",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run server:dev\" \"npm run vite:dev\"",
    "vite:dev": "vite --configLoader runner",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "node dist-server/server/index.js",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.worker.json --pretty false",
    "build": "tsc -b && vite build --configLoader runner",
    "sites:dev": "npm run sites:db:apply && cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite --host 127.0.0.1 --config vite.sites.config.mts",
    "sites:build": "tsc -p tsconfig.worker.json && cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite build --config vite.sites.config.mts",
    "sites:preview": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite preview --host 127.0.0.1 --config vite.sites.config.mts",
    "sites:db:apply": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log MINIFLARE_REGISTRY_PATH=.wrangler/registry wrangler d1 migrations apply study-record-local --local --config wrangler.sites.jsonc",
    "preview": "npm run server:start",
    "test": "vitest run --config vitest.config.mts --configLoader runner",
    "test:watch": "vitest --config vitest.config.mts --configLoader runner"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "10.1.0",
    "jsdom": "^27.3.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15",
    "wrangler": "4.92.0"
  }
}
