{
  "name": "study-lecture",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sites:dev",
    "typecheck": "tsc -p tsconfig.app.json --pretty false && tsc -p tsconfig.worker.json --pretty false",
    "build": "npm run typecheck && npm run sites:build",
    "sites:dev": "npm run sites:db:apply && cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite --host 127.0.0.1 --config vite.sites.config.mts",
    "sites:build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite build --config vite.sites.config.mts",
    "sites:preview": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite preview --host 127.0.0.1 --config vite.sites.config.mts",
    "sites:db:apply": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log MINIFLARE_REGISTRY_PATH=.wrangler/registry wrangler d1 migrations apply study-record-local --local --config wrangler.sites.jsonc",
    "preview": "npm run sites:preview",
    "test": "vitest run --config vitest.config.mts --configLoader runner",
    "test:watch": "vitest --config vitest.config.mts --configLoader runner",
    "test:worker": "node scripts/smoke-worker.mjs"
  },
  "dependencies": {
    "@heroui-pro/react": "^1.0.0-beta.8",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@internationalized/date": "^3.12.4",
    "@tailwindcss/vite": "^4.3.3",
    "motion": "^13.2.0",
    "react-aria-components": "^1.21.1",
    "react-resizable-panels": "^4.12.4",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "10.1.0",
    "jsdom": "^27.3.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15",
    "wrangler": "4.92.0",
    "better-sqlite3": "^12.10.0",
    "miniflare": "4.20260515.0"
  },
  "overrides": {
    "tar": "7.5.22"
  }
}
