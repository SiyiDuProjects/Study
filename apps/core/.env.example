# Public HTTPS origin, with no trailing slash.
PUBLIC_ORIGIN=https://study.siyidu.com
PORT=8794
DATABASE_PATH=./data/canvas.sqlite

# Generate with: openssl rand -base64 32
MASTER_KEY_BASE64=

# WebAuthn relying-party settings. RP_ID must be the hostname only.
WEBAUTHN_RP_ID=study.siyidu.com
WEBAUTHN_RP_NAME=Study

# Optional development-only switches. Never enable in production.
TRUST_PROXY=1
COOKIE_SECURE=true
LOG_LEVEL=info

# Dedicated, different bearer secrets for the two private container-to-container
# directions. Generate each independently; never reuse a Canvas PAT or OAuth token.
STUDY_SERVICE_TOKEN=
LECTURE_API_URL=
LECTURE_SERVICE_TOKEN=
# Private Sites dispatch token sent only in OAI-Sites-Authorization.
LECTURE_SITE_AUTH_TOKEN=
COURSE_SYNC_MIN_INTERVAL_SECONDS=300

# Keep disabled until a Hanyang course is available for read-only integration testing.
LEARNINGX_ENABLED=false

# Private-pilot OAuth and short-lived step-up limits.
OAUTH_DCR_ENABLED=true
OAUTH_MAX_CLIENTS=8
STEP_UP_FLOW_TTL_SECONDS=300
STEP_UP_TOKEN_TTL_SECONDS=120

# Separately authorized Inbox send/reply release.
CANVAS_MESSAGES_ENABLED=false

# Shared Berkeley/Hanyang uploads and submissions. The existing Study authorization covers enabled capabilities.
CANVAS_COURSEWORK_WRITES_ENABLED=false
# Exact HTTPS upload storage origins, separated by school; empty allows only that school Canvas origin.
CANVAS_BERKELEY_UPLOAD_ORIGINS=
CHATGPT_FILE_ORIGINS=https://files.oaiusercontent.com
CANVAS_UPLOAD_ORIGINS=
