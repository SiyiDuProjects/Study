NODE_ENV=production
PORT=3000
LECTURE_PUBLIC_ORIGIN=https://lecture.gaid.studio

# Exact internal Study Core service. It owns the encrypted Hanyang PAT.
STUDY_API_URL=http://canvas:8794
STUDY_SERVICE_TOKEN=replace-with-study-service-token

# Independent token used only when Study MCP reads lecture records.
LECTURE_SERVICE_TOKEN=replace-with-lecture-service-token

# Explicit, user-approved public browser mode. Production refuses to start when
# LECTURE_AUTH_MODE is missing or misspelled. Every browser maps to the one
# internal Hanyang owner; this is not an account or tenant selector.
LECTURE_AUTH_MODE=public

OPENAI_API_KEY=replace-with-server-openai-key

# Keep the legacy filename during the first migration so history remains visible.
LECTURE_DB_PATH=/data/jiahuan.sqlite
LECTURE_STATIC_DIR=/app/dist
